@extends('default')
@section('content')
<script server>
import { learnApi, shelf } from '~/app/Support/academy'

const { school, entries } = await shelf()
const pageTitle = 'Series'
const pageDescription = 'Every LessonStack series, by topic and level.'
const canonicalPath = '/series'
</script>
<div class="mx-auto pt-14 px-4 md:px-8 max-w-6xl">
  <h1 class="font-bold font-display text-5xl text-ink tracking-tight">Series</h1>
  <p class="mt-3 max-w-[60ch] text-lg text-muted">Pick a topic, or start at the top. The first episode of each is free.</p>
