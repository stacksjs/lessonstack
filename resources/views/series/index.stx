    <CursioCatalog :school="school" :entries="entries" home="/series" :api="learnApi" :heading="false" />
  @else
    <p class="mt-8 p-6 text-muted bg-tint rounded-2xl">The series list could not be loaded just now. Try again in a moment.</p>
  @endif
</div>
