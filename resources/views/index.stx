@extends('default')
@section('content')
<script server>
import { learnApi, openingEpisodes, series, shelf } from '~/app/Support/academy'

// Everything on this page is read from the academy: the series, their
// episodes and the three numbers under the headline.
const { school, entries, totals } = await shelf()
// The series a newcomer should open first: the one filed under getting
// started, else any for beginners.
const first = entries.find(entry => entry.topic === 'Getting started') || entries.find(entry => entry.level === 'beginner') || entries[0] || null
const opened = first ? await series(first.slug) : null
const opening = first && opened ? openingEpisodes(first.slug, opened.outline, 5) : []
const canonicalPath = '/'
</script>
<section class="mx-auto pt-14 px-4 md:pt-24 md:px-8 max-w-6xl">
  <div class="grid gap-12 grid-cols-1 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="font-medium text-accent text-sm">Learn the Stacks framework</p>
      <h1 class="mt-4 max-w-[14ch] font-bold font-display leading-[0.98] text-5xl text-ink tracking-tight md:text-7xl">Learn Stacks by building with it.</h1>
      <p class="mt-6 max-w-[52ch] leading-relaxed text-lg text-muted">Short episodes that take you from an empty folder to a deployed app. The first episode of every series is free, and your place is kept for you.</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="/series" class="inline-flex items-center px-6 h-12 font-medium text-accent-ink bg-accent rounded-full transition-transform active:scale-[0.98]">Browse the series</a>
        <a href="/register" class="inline-flex items-center px-6 h-12 font-medium text-ink hover:bg-tint border border-line rounded-full transition-colors">Create a free account</a>
      </div>
      @if(totals.series > 0)
        <dl class="flex flex-wrap gap-x-10 gap-y-4 mt-12">
          <div>
            <dt class="text-muted text-sm">Series</dt>
            <dd class="mt-1 font-bold font-display tabular-nums text-3xl text-ink">{{ totals.series }}</dd>
          </div>
          <div>
            <dt class="text-muted text-sm">Episodes</dt>
            <dd class="mt-1 font-bold font-display tabular-nums text-3xl text-ink">{{ totals.episodes }}</dd>
          </div>
          @if(totals.time)
            <div>
              <dt class="text-muted text-sm">Running time</dt>
              <dd class="mt-1 font-bold font-display tabular-nums text-3xl text-ink">{{ totals.time }}</dd>
            </div>
          @endif
        </dl>
      @endif
    </div>

    @if(first && opening.length > 0)
      <aside class="lg:col-span-5" aria-labelledby="start-here">
        <div class="p-6 bg-surface border border-line rounded-2xl">
          <p id="start-here" class="font-medium text-muted text-sm">Start here</p>
          <a href="/series/{{ first.slug }}" class="block mt-1 font-bold font-display text-2xl text-ink tracking-tight hover:text-accent transition-colors">{{ first.title }}</a>
          <ol class="flex flex-col mt-5 divide-line divide-y">
            @foreach(opening as episode)
              <li>
                <a href="{{ episode.href }}" class="flex gap-4 items-center py-3 text-sm hover:text-accent transition-colors">
                  <span class="w-5 font-mono tabular-nums text-muted">{{ episode.number }}</span>
                  <span class="flex-1 text-ink">{{ episode.title }}</span>
                  @if(episode.free)
                    <span class="px-2 py-0.5 font-medium text-accent text-xs bg-accent-soft rounded-full">Free</span>
                  @endif
                  <span class="font-mono tabular-nums text-muted">{{ episode.clock }}</span>
                </a>
              </li>
            @endforeach
          </ol>
        </div>
      </aside>
    @endif
  </div>
</section>

<section class="mt-20 mx-auto px-4 md:mt-28 md:px-8 max-w-6xl" aria-labelledby="all-series">
  <h2 id="all-series" class="font-bold font-display text-3xl text-ink tracking-tight">All series</h2>
  @if(school)
    <CursioCatalog :school="school" :entries="entries" home="/series" :api="learnApi" :heading="false" />
  @else
    <p class="mt-6 p-6 text-muted bg-tint rounded-2xl">The series list could not be loaded just now. Try again in a moment.</p>
