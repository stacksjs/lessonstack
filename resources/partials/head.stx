{{-- The head every page shares, included by layouts/default.stx. A page names
  itself by declaring pageTitle, pageDescription or canonicalPath in its own
  server script; a page that declares none of them describes the site. --}}
<script server>
import { config } from '@stacksjs/config'
import { site } from '~/resources/data/site'

// APP_URL is often a bare host (`lessonstack.localhost`), which is not a valid
// canonical href on its own.
const rawUrl = String(config.app.url || '').replace(/\/+$/, '')
const siteUrl = rawUrl && !/^https?:\/\//.test(rawUrl) ? `https://${rawUrl}` : rawUrl

const headTitle = typeof pageTitle !== 'undefined' && pageTitle ? `${pageTitle} - ${site.name}` : site.title
const headDescription = typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : site.description
const headPath = typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : '/'
const canonicalUrl = siteUrl ? `${siteUrl}${headPath}` : ''
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ headTitle }}</title>
<meta name="description" content="{{ headDescription }}">
@if(canonicalUrl)
  <link rel="canonical" href="{{ canonicalUrl }}">
@endif
<meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ headTitle }}">
<meta property="og:description" content="{{ headDescription }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/api/cursio/academy.css">
<link rel="stylesheet" href="/assets/styles/lessonstack.css">
